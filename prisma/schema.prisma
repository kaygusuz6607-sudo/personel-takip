datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  username  String?  @unique
  email     String?  @unique
  password  String
  name      String
  role      String   @default("SUPER_ADMIN") // SUPER_ADMIN, ADMIN, ACCOUNTANT, READ_ONLY
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  category    String?           @default("TEACHER") // TEACHER (Öğretmen), ADMIN (İdari Personel), STAFF (Personel), BRANCH (Branşlar)
  staffs      StaffDepartment[]
  createdAt   DateTime          @default(now())
}

model StaffDepartment {
  staffId      String
  departmentId String
  staff        Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([staffId, departmentId])
}

model Staff {
  id                   String            @id @default(uuid())
  tcNo                 String            @unique
  fullName             String
  birthDate            DateTime?
  phone                String?
  phone2               String?           // 2. Telefon (Kurum İçi / İş Hattı)
  email                String?
  iban                 String?
  accountNumber        String? // Banka Hesap Numarası
  title                String? // Öğretmen, İdari Personel, vb.
  hireDate             DateTime?
  terminationDate      DateTime?
  mebAssignmentDate    DateTime?
  mebAssignmentEndDate DateTime? // MEB Atama Bitiş Tarihi (Süreli ise)
  isMebPermanent       Boolean           @default(true) // Süresiz atama mı? (true = Süresiz, false = Tarihli)
  isMebEndNotified     Boolean           @default(false) // Bitiş uyarısı kapatıldı/yenilendi mi?
  unofficialWorkPeriod String? // "3 ay 12 gün" vb.
  sgkStartDate         DateTime?
  notes                String?
  status               String            @default("ACTIVE") // ACTIVE, PASSIVE, ON_LEAVE
  isSgkNotified        Boolean           @default(false)
  photoUrl             String?           // Personel vesikalık / profil fotoğrafı (Base64 veya URL)
  
  departments          StaffDepartment[]
  salaryConfig         SalaryConfig?
  payrolls             Payroll[]
  leaves               LeaveRecord[]
  
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model SalaryConfig {
  id                 String   @id @default(uuid())
  staffId            String   @unique
  staff              Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  salaryType         String   @default("MONTHLY") // MONTHLY, HOURLY, DAILY, HYBRID
  monthlySalary      Float    @default(0)
  hourlyRate         Float    @default(0)
  dailyRate          Float    @default(0)
  officialSalaryPart Float    @default(0)
  updatedAt          DateTime @updatedAt
}

model Payroll {
  id                   String    @id @default(uuid())
  staffId              String
  staff                Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  year                 Int
  month                Int       // 1 - 12
  workDays             Int       @default(30) // SGK standardı 30
  reportDays           Int       @default(0)
  unpaidLeaveDays      Int       @default(0)
  lessonHours          Float     @default(0)
  dailyWorkDays        Int       @default(0)
  holidayWorkDays      Int       @default(0)
  holidayChoice        String    @default("LEAVE_1_TO_1") // LEAVE_1_TO_1 (1'e 1 izin) veya DOUBLE_PAY (çift yevmiye)
  
  // Hesaplanan Kalemler
  baseEarned           Float     @default(0)
  hourlyEarned         Float     @default(0)
  dailyEarned          Float     @default(0)
  holidayEarned        Float     @default(0)
  
  // Ek Ücret (+) ve Manuel Kesinti (-) (Kullanıcının talep ettiği çoklu esnek sistem)
  bonusAmount          Float     @default(0) // Prim, Yol vb. (+)
  bonusDescription     String?
  bonusItems           String?   // JSON formatında çoklu kalemler: [{ id, amount, description }]
  deductionAmount      Float     @default(0) // Avans, Ceza vb. (-)
  deductionDescription String?
  deductionItems       String?   // JSON formatında çoklu kalemler: [{ id, amount, description }]
  
  grossTotal           Float     @default(0)
  
  // Kesintiler
  sgkEmployee          Float     @default(0) // Opsiyonel yasal kesinti
  unemploymentEmployee Float     @default(0)
  incomeTax            Float     @default(0)
  stampTax             Float     @default(0)
  isManualTax          Boolean   @default(false)
  totalDeductions      Float     @default(0)
  
  netTotal             Float     @default(0)
  officialAmount       Float     @default(0) // Resmî SGK hesabından yatan
  unofficialAmount     Float     @default(0) // Elden / gayriresmî yatan
  
  isPaid               Boolean   @default(false)
  paidDate             DateTime?
  notes                String?
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([staffId, year, month])
}

model LeaveRecord {
  id          String   @id @default(uuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leaveType   String   // ANNUAL, SICK, HOLIDAY_COMPENSATION (Resmi Tatil Telafisi), EXCUSE, UNPAID
  startDate   DateTime
  endDate     DateTime
  daysCount   Float
  description String?
  status      String   @default("APPROVED") // APPROVED, PENDING, REJECTED
  createdAt   DateTime @default(now())
}

model SchoolExpense {
  id              String    @id @default(uuid())
  title           String    // Cari / Kurum / Kişi Adı
  category        String    // RENT, INVOICE, CREDIT_CARD, LOAN, STUDENT_REFUND, CHEQUE, TAX_SGK, SALARY, COMPENSATION, OTHER
  subCategory     String?   // Alt Kategori (F-Elektrik, F-Su, F-Doğalgaz, F-Haberleşme, vb.)
  period          String?   // Dönem (7.Ay, 8.Ay vb.)
  installmentInfo String?   // Taksit Durumu (4t/8t, 3t/10t, 2t/3t vb.)
  dueDate         DateTime? // Vade Tarihi
  dueDateStr      String?   // Tarih Metni (Örn: 15 Ağustos 2026)
  amountDue       Float     @default(0) // Ödenecek Tutar
  amountPaid      Float     @default(0) // Ödenen Tutar
  amountRemaining Float     @default(0) // Kalan Tutar
  status          String    @default("PENDING") // PENDING, PARTIAL, PAID
  periodStatus    String?   // Cari Dönem, Geçmiş Dönem, vb.
  description     String?   // Açıklama / Not
  paymentHistory  String?   // JSON parçalı ödemeler listesi
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
